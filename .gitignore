input/country-data/EMHIRES_WIND_NUTS2_June2019.xlsx
/input/country-data
/tools
# Build artefacts (catch both legacy root and src/ layout locations)
**/pyvwf.egg-info/
/dist/
/build/
/docs/_build/
/input/terrain
# Real power-curve library (renewables.ninja / VWF / thewindpower.net): kept
# local-only and never redistributed. The repo ships the open turbine curve
# library (NatLabRockies/turbine-models, BSD-3) at input/power_curves.csv and
# input/models.csv instead. See input/README.md.
input/power_curves.real.csv
input/models.real.csv
# Turbine metadata and observed generation are typically proprietary and are
# never committed (README "Input data"). Redundant with the blanket /input
# rule below, but kept explicit so the intent survives if that rule changes.
input/turbine_level_data/
/input
/output
/out
/overleaf

# Internal research-log docs kept local-only (research dates, "next steps"
# language not appropriate for the public-facing docs/ folder).
docs/TRAINING_2015_2021_SUMMARY.md
docs/TURBINE_GRID_EVALUATION_ANALYSIS.md

# Python build artifacts
build/

# Test and coverage artifacts: regenerated by every pytest/coverage run, so
# they never belong in a release archive.
.coverage
coverage.xml
htmlcov/
.pytest_cache/
