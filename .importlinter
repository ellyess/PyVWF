# Import contracts for src/pyvwf. Checked in CI with `lint-imports`.
#
# A module may import from the layers below it, never from a layer above. The
# layering was derived from an AST pass over every module (the repository
# audit of 2026-09-18) and holds with no ignored imports. What import-linter
# cannot express, because it models modules rather than names and scripts/ is
# not a package, is that scripts use only public pyvwf names; that rule is a test,
# tests/test_public_analysis_api.py.

[importlinter]
root_package = pyvwf
# An import under `if TYPE_CHECKING:` is for annotations and never runs.
exclude_type_checking_imports = True

[importlinter:contract:pyvwf-layers]
name = PyVWF layers
type = layers
layers =
    pyvwf.cli | pyvwf.extensions | pyvwf.pinn | pyvwf.viz
    pyvwf.harness
    pyvwf.data
    pyvwf.sources | pyvwf.country_level
    pyvwf.loaders | pyvwf.datasets | pyvwf.provenance | pyvwf.curves
    pyvwf.correction | pyvwf.sampling | pyvwf.era5
    pyvwf.clustering | pyvwf.wind
    pyvwf.config | pyvwf.utils | pyvwf.time_utils | pyvwf.metrics | pyvwf.geospatial | pyvwf.resources | pyvwf._version

[importlinter:contract:harness-layers]
name = Harness layers
type = layers
containers = pyvwf.harness
layers =
    driver | export | hindcast
    records | scoring
    corrections | skill
    regions | bootstrap

[importlinter:contract:pinn-layers]
name = PINN layers
type = layers
containers = pyvwf.pinn
layers =
    train | runs
    cache
    era5_stats | model | physics | terrain | gwa
